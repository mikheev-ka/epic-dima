# ============================================================
# ТАВЕРНА (ОДИНОЧНАЯ И С ЛИРОЙ) – ПОЛНАЯ ВЕРСИЯ
# ============================================================
#
# Этот файл содержит сцены, связанные с таверной:
# - одиночное посещение (без Лиры)
# - посещение вместе с Лирой
# - мини-игра в крестики-нолики с трактирщиком
# - дуэль с трактирщиком (боевая механика с QTE)
# - ветки продажи/защиты Лиры
# - взрослые сцены (секс с Розой, групповое изнасилование/деградация Лиры)
#
# Все диалоги и тексты оставлены без изменений.
# Комментарии поясняют структуру и логику каждого блока.
# ============================================================

# ---------- ИНИЦИАЛИЗАЦИЯ СПИСКОВ ФРАЗ (Python) ----------
# Здесь определяются глобальные списки строк для разных ситуаций:
# - победа/поражение/ничья в крестики-нолики с трактирщиком
# - реплики трактирщика и игрока в дуэли
# Эти списки используются для случайного выбора фраз, чтобы диалоги были разнообразнее.
init python:
    # Списки фраз для бармена (глобальные)
    tavern_win_phrases = [
        "Твоя взяла! Забирай свои 30 крон и проваливай наверх.",
        "Удача на твоей стороне. 30 крон твои. Не задерживайся.",
        "Неплохо, неплохо. 30 крон — плата за твою наглость.",
        "Ты оказался сильнее. Забирай 30 крон, пока я не передумал.",
        "Хорошая игра. 30 крон твои. Надеюсь, ты сдохнешь от эля."
    ]
    # Фразы для поражения
    tavern_lose_phrases = [
        "Ты проиграл! Эй, вышвырните этого бродягу!",
        "Ха! Слабак! Вон отсюда!",
        "Проиграл! Уберите его с глаз моих!",
        "Ты ничтожество. Вышвырните его!",
        "Ещё один неудачник. Вон!"
    ]
    # Фразы для ничьей
    tavern_draw_phrases = [
        "Ничья! Вышвырните его!",
        "Боевая ничья, но я всё равно вышвырну тебя.",
        "Поровну – значит, ты не выиграл. Вон!",
        "Ничья – не победа. Убирайся."
    ]
    # Фразы для сдачи (приравнивается к поражению)
    tavern_concede_phrases = [
        "Сдаёшься? Трус. Вышвырните его!",
        "Слабохарактерный. Вон!",
        "Ты даже не попытался. Выкиньте его!",
        "Сдался? Позор. Вон!"
    ]

    # Фразы для дуэли с трактирщиком (в зависимости от стадии боя)
    barman_phrases_start = [
        "Ну что, щенок, готов получить по зубам?",
        "Я вышибу из тебя дух!",
        "Сейчас я покажу тебе, что такое настоящая драка!",
        "Ты пожалеешь, что связался со мной!"
    ]
    barman_phrases_mid = [
        "Неплохо... но ты всё равно проиграешь!",
        "Ты сильнее, чем я думал, но этого мало!",
        "Моя очередь!",
        "Сейчас я тебя прикончу!"
    ]
    barman_phrases_low = [
        "Ты... ты меня достал!",
        "Я не сдамся, даже если умру!",
        "Получай, гад!",
        "Ты заплатишь за каждую царапину!"
    ]
    barman_phrases_defeat = [
        "Нет... я проиграл...",
        "Ты победил... таверна твоя...",
        "Как я мог проиграть такому сопляку...",
        "Ладно... бери, что хочешь..."
    ]
    barman_phrases_victory = [
        "Ха-ха! Сдох!",
        "Так тебе и надо, выродок!",
        "Я всегда выигрываю!",
        "Попробуй ещё раз, если жить надоело!"
    ]
    # Реплики игрока в дуэли (разные типы действий)
    player_phrases_attack_tavern = [
        "Держи удар!",
        "Получай, старый пьяница!",
        "Я не боюсь тебя!",
        "Это тебе за Лиру!"
    ]
    player_phrases_dodge_tavern = [
        "Мимо!",
        "Слишком медленно!",
        "Попробуй ещё раз!",
        "Не догонишь!"
    ]
    player_phrases_get_hit_tavern = [
        "Ах, чёрт!",
        "Больно... но я не сдамся!",
        "Ты силён... но я сильнее!",
        "Ничего, я отомщу!"
    ]
    player_phrases_key_tavern = [
        "Смотри, что у меня есть!",
        "Ослепительный свет!",
        "Ключ работает!",
        "Это тебя отрезвит!"
    ]


# ---------- МЕТКА: tavern_alone (одиночное посещение) ----------
# Эта метка запускается, когда игрок заходит в таверну без Лиры.
# Здесь происходит встреча с трактирщиком, предложение сыграть в крестики-нолики,
# а затем, в случае победы, — встреча с Розой (проституткой) с выбором провести с ней ночь или отказаться.
label tavern_alone:
    stop music                                  # Останавливаем текущую фоновую музыку
    play music music_tavern loop                # Запускаем музыку таверны (зацикленно)
    scene bg bar with fade                      # Отображаем фон таверны с эффектом затухания

    "Захожу в таверну. Тепло, эль, жареное мясо. Пахнет жизнью и хмелем. И ещё чем-то – может быть, отчаянием, которое приходит с пустыми карманами."

    "Внутри шумно, но я слышу только своё дыхание. Люди сидят за столами, смеются, пьют. У них есть цель. У меня её нет."

    show gg tired at center_pos                 # Показываем спрайт Димы (уставший) в центре
    show barmen stand at right_pos              # Показываем спрайт бармена справа

    barman "Ну, путник. Что нужно: еда, ночлег или выпивка? Или, может, всё сразу, как я погляжу?"

    "Он оценивает меня взглядом. Не враждебно, скорее – профессионально. Он видел тысячи таких, как я. Уставших, потерянных, без гроша в кармане."

    gg "Всё сразу. Но денег нет. Ни гроша."

    barman "Ха! Бродяга. Ты не первый, кто заходит с пустыми карманами. Могу помочь тебе, но на халяву тут ничего не дают. 30 крон — и ты получаешь комнату на втором этаже, горячий ужин и кружку тёмного эля. Это даром, поверь."

    gg "А если я не могу заплатить?"

    barman "Тогда сыграй со мной в крестики-нолики. Если выиграешь — 30 крон твои. Если проиграешь — я заберу твою куртку и всё, что у тебя есть. Идёт?"

    menu:
        "Сыграть.":
            jump tavern_checkers_alone          # Переход к мини-игре
        "Отказаться.":
            "Разворачиваюсь и ухожу. Мне не нужна эта игра."
            jump end_chapter                    # Переход к концу главы (предположительно, где-то определён)


# ---------- МЕТКА: tavern_checkers_alone (мини-игра в одиночку) ----------
# Здесь вызывается мини-игра "крестики-нолики" (определена в tic_tac_toe_logic.rpy)
# Результат сохраняется в переменную result, далее обрабатывается.
label tavern_checkers_alone:
    "Бармен достаёт поле для крестиков-ноликов. Я смотрю на девять клеток и чувствую, как мир сужается до этих трёх линий."

    call play_checkers(30) from _call_play_checkers    # Вызов игры со ставкой 30 крон
    $ result = _return                                 # Сохраняем результат ("player", "ai" или "draw")

    if result == "player":
        $ phrase = renpy.random.choice(tavern_win_phrases)   # Случайная фраза победы
        barman "[phrase]"
        $ money += 30                                       # Начисляем выигрыш
        "Я чувствую, как монеты тяжелеют в кармане. Удача – редкий гость в моей жизни. Слишком редкий, чтобы ей доверять."
        jump tavern_after_win_alone                         # Переход к сцене после победы

    elif result == "ai":
        $ phrase = renpy.random.choice(tavern_lose_phrases) # Фраза поражения
        barman "[phrase]"
        "Чьи-то руки хватают меня. Я слышу смех за спиной."
        scene bg street_night with fade                     # Смена фона на ночную улицу
        show gg fall3 at center_pos                         # Спрайт Димы падающего
        "Падаю в грязь. Из тени — трое цыган. Они хватают меня, и я понимаю, что проиграл всё. Не только монеты – но и право выбирать."
        gypsy "Ещё один бездомный. Забираем."
        scene black with fade                               # Затемнение — конец (плохая концовка)
        "Рабство у цыган. Я смотрю, как растворяется мир, и думаю о том, что это могло быть моей жизнью всегда – просто в другом месте."
        return                                              # Выход из сценария (игра заканчивается)

    else:  # draw (ничья)
        $ phrase = renpy.random.choice(tavern_draw_phrases)
        barman "[phrase]"
        "Смотрю на поле. Ничья – это не победа. Меня хватают и вышвыривают на улицу."
        scene bg street_night with fade
        show gg fall3 at center_pos
        "Падаю в грязь. Дождь смывает грязь, но не стыд. Я проиграл – и теперь я ничто."
        jump end_chapter                                     # Переход к концу (плохая концовка)


# ---------- МЕТКА: tavern_after_win_alone (после победы в одиночку) ----------
# Игрок выиграл у трактирщика, получает деньги, заказывает ужин.
# Затем появляется Роза (проститутка) и предлагает провести ночь за 20 крон.
label tavern_after_win_alone:
    scene bg bar with fade                                  # Возвращаем фон таверны
    show gg smile at left_pos                               # Дима улыбается
    show barmen stand at right_pos

    "Сажусь за столик. Заказываю ужин и эль. Вкус горечи на языке почти забыт. Горячее мясо – это нечто большее, чем еда. Это напоминание, что я ещё жив."

    "Эль горчит, но я пью его как лекарство. Как будто можно утопить память в хмеле."

    show gg thinking at left_pos
    gg "Тридцать крон в кармане. Целых тридцать. Для человека, который вчера не имел ни гроша, это целое состояние. Но чего они стоят? Просто бумажки в мире, где я даже не знаю, куда идти."

    barman "Эй, парень, ты чего такой кислый? Выиграл – радуйся. В этой таверне не часто везёт таким, как ты."

    gg "Радоваться? Может быть. Но я не чувствую победы. Просто… пустота. Как будто я выиграл битву, но проиграл войну."

    barman "Слушай, я тут много чего видел. Ты не первый, кто приходит с пустыми руками, и не первый, кто уходит с полными. Но то, что у тебя в голове – это важнее, чем монеты. Ты ищешь что-то, парень?"

    gg "Я ищу выход. Из этого города, из своей головы, из всего этого дерьма. Но, кажется, я просто топчусь на месте."
    scene bg tavern_eat with fade                           # Смена фона на обеденный стол (атмосфера)
    "Бармен качает головой и уходит к стойке. Я остаюсь один за столом. Тишина вокруг – как гул в ушах. Допиваю эль и смотрю на пустую кружку."

    scene bg bar with fade                                  # Возврат в общий зал
    pause 1.0
    scene bg bar with fade
    show prostitute stand at center_pos                     # Появляется Роза

    "Вдруг рядом появляется женщина. Роза. Она смотрит на меня, и в её взгляде – предложение, которое я не должен принимать. Она садится напротив, не спрашивая разрешения."

    show gg smoking at left_pos
    show prostitute stand at right_pos
    "Я смотрю на неё. Красивая. И опасная. Как всё, что обещает забытье. Её платье – яркое, вызывающее, глаза – хитрые, с искоркой. Она явно знает себе цену."

    gg "Роза, значит. Красивое имя. Ты всегда так подходишь к незнакомцам?"

    prostitute "Только к тем, кто выглядит потерянным. А ты выглядишь именно так, словно ищешь, куда бы деть свою боль. Или свои деньги."

    gg "Боль? Скорее, усталость. Я уже вторые сутки не сплю. Глаза слипаются, но стоит закрыть их – начинаю думать о работе."

    prostitute "О работе? Ты что, так любишь свой офис?"

    gg "Люблю? Ненавижу. Каждый день одно и то же: «У меня не работает интернет», «Перезагрузите роутер». И ты улыбаешься в трубку, когда внутри всё горит."

    prostitute "Звучит как ад. Почему ты не уйдёшь?"

    gg "Куда? У нас сокращение. Начальство дышит в спину, и каждый день я жду, что меня вызовут и скажут: «Дима, ты свободен». И тогда всё – никаких денег, никакой надежды."

    "Она молчит, но я вижу, что она слушает. Её взгляд стал серьёзнее."

    gg "А ещё я лысею. Мне двадцать четыре, а у меня уже залысины. Каждое утро смотрю в зеркало и вижу чужого человека. Старого, уставшего, никому не нужного."

    prostitute "Ты так говоришь, будто жизнь кончилась. Но ты жив, у тебя есть деньги, ты можешь хотя бы сегодня забыть о проблемах. Это стоит того?"

    gg "Забыть? Можно ли забыть о том, что завтра тебя уволят, а потом ты останешься на улице с пустыми карманами?"

    prostitute "Завтра будет завтра. А сегодня – я здесь. И я предлагаю тебе не просто секс. Я предлагаю тебе перестать быть Димой из техподдержки на несколько часов. Стать кем-то другим. Или просто никем."

    "Я смотрю на неё, и впервые за долгое время чувствую, что кто-то меня понимает. Не жалеет, не советует – просто принимает."

    gg "Ты странная, Роза. Обычно девушки вроде тебя говорят совсем другое."

    prostitute "Я не обычная. Я тоже ищу что-то. Может быть, мы оба просто пытаемся сбежать от реальности. Только ты хочешь забыть, а я хочу вспомнить, что я ещё жива."

    "Она пододвигает ко мне свою кружку с элем. Я делаю глоток – горько, но приятно."

    prostitute "Ну что, решился? 20 крон – и я покажу тебе, как можно забыть на одну ночь. Или, если хочешь, я могу просто посидеть с тобой и поговорить. Цена – та же."

    "Я смотрю на неё. В её словах есть что-то, что заставляет меня сомневаться. Может быть, она не просто шлюха. Может быть, она тоже ищет что-то."

    "У меня есть выбор: провести с ней ночь или остаться одному. Но она права – я устал быть один."

    menu:
        "Согласиться." if money >= 20:                      # Доступно только если денег >= 20
            jump tavern_prostitute_alone_accept
        "Отказаться.":
            jump tavern_prostitute_alone_refuse


# ---------- МЕТКА: tavern_prostitute_alone_accept (согласие на секс с Розой) ----------
# Игрок тратит 20 крон, увеличивает параметр lust (похоть) на 2.
# Далее следуют несколько сцен с сексуальным содержанием (используются фоны bg rosa fuck1-7, звуки).
label tavern_prostitute_alone_accept:
    $ money -= 20                                          # Списание денег
    $ lust += 2                                            # Повышение похоти
    scene black with fade

    "Поднимаюсь в комнату. Роза за мной. Она пахнет духами, и этот запах смешивается с запахом дерева, сгоревшего в камине."

    prostitute "Раздевайся, мальчик. Покажи, на что способен."
    gg "Я не мальчик. Я — зверь. Но сегодня я хочу забыться."

    "Я срываю с неё платье. Она смеётся – тихо, без страха."


    # --- Сцена 1: Раздевание и поцелуи ---
    scene bg rosa fuck1 with dissolve
    "Мы падаем на кровать. Её тело горячее, влажное. Я впиваюсь в её огромные сиськи, она отвечает с той же жадностью."
    prostitute "Ммм... ты не из робких. Мне это нравится."
    gg "Я пришёл не за разговорами. Я хочу забыть всё, что было до."

    # --- Сцена 2: Оральные ласки (она делает минет) ---
    scene bg rosa fuck2 with dissolve
    "Я охватываю своими ладонями ее грудь."
    prostitute "Ты пахнешь потом и свободой. Обожаю такой запах."
    gg "Я хочу трахнуть твои дойки."
    prostitute "Как скажешь, зверь..."

    # --- Сцена 3: Миссионерская поза ---
    scene bg rosa fuck3 with dissolve
    play sound fuck_low loop volume 0.9                    # Звук секса (низкая громкость)
    "Я вхожу в ее бидоны. Она стонет, впиваясь ногтями в мои плечи."
    prostitute "О да... ты большой... и грубый. Идеально."
    gg "Я не люблю быть нежным. Ты выдержишь?"
    prostitute "Я выдерживала и не такое. Давай, покажи, на что ты способен."

    # --- Сцена 4: Наездница (она сверху) ---
    scene bg rosa fuck4 with dissolve
    play sound fuck loop volume 0.9                       # Звук секса (громче)
    "Переворачиваю её на живот, вхожу сзади. Её лицо уткнуто в подушку, но стоны становятся громче."
    prostitute "Ох... вот так... глубже... не останавливайся..."
    gg "Ты вся мокрая. Тебе нравится, когда грубо?"
    prostitute "Да... я люблю, когда чувствую, что меня берут, а не просто снимают."

    # --- Сцена 5: Секс сзади (раком) ---
    scene bg rosa fuck5 with dissolve
    "Она садится сверху и начинает двигаться сама, задавая ритм. Её грудь колышется, глаза закрыты."
    prostitute "Я люблю быть сверху... так я контролирую всё."
    gg "Ты хорошо это делаешь. Но я не люблю, когда мной управляют."
    "Я хватаю её за бёдра и начинаю двигаться снизу, ускоряясь. Она вскрикивает от неожиданности."


    # --- Сцена 6: Она на коленях, финиш на лицо ---
