        "Отказаться.":
            $ girl_affinity += 2                            # Увеличиваем привязанность Лиры
            gg "Она не продаётся. Убирайся."
            "Я встаю. Лира смотрит на меня с удивлением и благодарностью. Я чувствую, как моя рука сжимается в кулак."
            barman "Тогда проблемы. Будем решать по-мужски, без свидетелей. Выходи во двор."
            "Четверо мужиков смотрят на нас, но трактирщик жестом их останавливает. Он хочет драться один."
            jump tavern_duel_lira                          # Переход к дуэли


# ---------- МЕТКА: tavern_duel_lira (дуэль с трактирщиком) ----------
# Боевая механика, аналогичная бою с троллем (из основного сюжета).
# Используются те же переменные: hp_player, hp_troll, player_damage и т.д.
# Лира может помочь ножом, если здоровье игрока падает ниже 20.
# При поражении игрок может ретрайнуться (до 2 раз).
label tavern_duel_lira:
    hide barmen stand
    hide lira
    hide gg

    $ retry_count = 0                                     # Сбрасываем счётчик ретраев

    $ max_hp_player = 50
    $ max_hp_troll = 70                                   # У врага меньше здоровья, чем у тролля
    $ enemy_name = "Трактирщик"                           # Имя врага для HUD
    $ hp_player = 50
    $ hp_troll = 70
    $ player_damage = 5 + (bravery // 3)                  # Урон зависит от храбрости
    $ troll_damage = 12 - (bravery // 5)                  # Урон врага снижается с храбростью
    if has_key:
        $ player_damage += 4                              # Если есть ключ, он даёт бонус к урону
    $ battle_round = 0
    $ key_used = False
    $ lira_joined_battle = False

    "Я выхожу во двор. Трактирщик идёт за мной, снимая фартук. В руке у него — пустая бутылка из-под эля. У меня — такая же."
    "Лира смотрит из дверного проёма. Она не кричит. Она просто сжимает кулаки, как будто молится."

    # Первая реплика трактирщика
    $ b_phrase = renpy.random.choice(barman_phrases_start)
    barman "[b_phrase]"

    play music music_battle loop
    jump tavern_duel_loop                               # Переход к боевому циклу


# ---------- МЕТКА: tavern_duel_loop (основной цикл боя) ----------
# В этом цикле показывается HUD, проверяется состояние здоровья,
# предлагаются варианты действий (атака или использование ключа).
label tavern_duel_loop:
    show gg battle at left_battle
    show barmen fight1 at right_battle
    show screen battle_hud                               # Показываем интерфейс боя (HP, раунд)

    $ battle_round += 1

    if hp_player <= 0:
        hide screen battle_hud
        jump tavern_duel_lose
    if hp_troll <= 0:
        hide screen battle_hud
        jump tavern_duel_win

    # Динамические фразы трактирщика в зависимости от его здоровья
    if hp_troll > 50:
        if renpy.random.randint(1, 3) == 1:
            $ b_phrase = renpy.random.choice(barman_phrases_start)
            barman "[b_phrase]"
    elif hp_troll > 20:
        if renpy.random.randint(1, 2) == 1:
            $ b_phrase = renpy.random.choice(barman_phrases_mid)
            barman "[b_phrase]"
    else:
        if renpy.random.randint(1, 2) == 1:
            $ b_phrase = renpy.random.choice(barman_phrases_low)
            barman "[b_phrase]"

    # Если здоровье игрока <= 20 и Лира ещё не помогала, она бросает нож
    if hp_player <= 20 and not lira_joined_battle:
        $ lira_joined_battle = True
        "Лира бросает мне нож, который нашла в подсобке!"
        $ player_damage += 5
        lira "Держи, ублюдок! Не дай ему тебя убить!"

    "Твой ход. Что будешь делать?"
    menu:
        "⚔ Атаковать":
            jump tavern_duel_attack
        "🔑 Использовать ключ" if has_key and not key_used:
            jump tavern_duel_key


# ---------- МЕТКА: tavern_duel_attack (атака игрока) ----------
# Игрок наносит урон, равный player_damage + случайное число (0-3).
label tavern_duel_attack:
    show gg fight2 at left_battle
    $ damage = player_damage + renpy.random.randint(0, 3)
    $ hp_troll -= damage

    $ p_phrase = renpy.random.choice(player_phrases_attack_tavern)
    gg "[p_phrase]"
    "Ты наносишь [damage] урона. (Трактирщик: [hp_troll] HP)"
    show barmen fight1 at right_battle
    pause 0.5
    show barmen fight1 at right_battle
    show gg battle at left_battle

    if hp_troll <= 0:
        hide screen battle_hud
        jump tavern_duel_win

    jump tavern_barman_turn                              # Переход к ходу врага


# ---------- МЕТКА: tavern_duel_key (использование ключа) ----------
# Ключ ослепляет врага, нанося тройной урон (player_damage*3).
# Однократное использование.
label tavern_duel_key:
    stop music
    play sound key
    with flash                                           # Эффект вспышки
    $ key_used = True
    $ hp_troll -= player_damage * 3

    $ k_phrase = renpy.random.choice(player_phrases_key_tavern)
    gg "[k_phrase]"
    "Ключ ослепляет трактирщика! Вспышка света заставляет его отшатнуться!"
    show gg fight at left_battle
    show barmen fight1 at right_battle
    pause 0.5
    play music music_battle loop
    show gg battle at left_battle
    show barmen fight1 at right_battle

    "Тройной урон! [player_damage*3] урона. (Трактирщик: [hp_troll] HP)"

    if hp_troll <= 0:
        hide screen battle_hud
        jump tavern_duel_win

    jump tavern_barman_turn


# ---------- МЕТКА: tavern_barman_turn (ход трактирщика) ----------
# Враг атакует, игрок должен увернуться через QTE (quick time event).
# Время на уклонение уменьшается с каждым раундом (становится сложнее).
label tavern_barman_turn:
    # Ход трактирщика – игрок уклоняется через QTE
    $ qte_time = max(0.7, 1.5 - (battle_round - 1) * 0.08)   # Время от 0.7 до 1.5 сек

    call screen dodge_choice(time=qte_time, round=battle_round)   # Вызов экрана QTE (определён отдельно)
    $ result = _return

    if result == "success":
        $ p_phrase = renpy.random.choice(player_phrases_dodge_tavern)
        gg "[p_phrase]"
        "Ты успешно уклоняешься от удара трактирщика!"
        show gg dodge at left_battle
        pause 0.8
        show gg battle at left_battle
    else:
        $ hp_player -= troll_damage
        $ p_phrase = renpy.random.choice(player_phrases_get_hit_tavern)
        gg "[p_phrase]"
        "Бутылка трактирщика входит в твоё плечо. Боль – как электрический ток. (Ты: [hp_player] HP)"
        show gg impact3 as gg at left_battle
        pause 0.8
        show gg battle at left_battle

    if hp_player <= 0:
        hide screen battle_hud
        jump tavern_duel_lose

    jump tavern_duel_loop


# ---------- МЕТКА: tavern_duel_win (победа в дуэли) ----------
# Игрок побеждает трактирщика, становится владельцем таверны.
# В зависимости от значений girl_affinity и lust открывается романтическая ветка с Лирой.
label tavern_duel_win:
    stop music
    play music music_tavern loop
    hide screen battle_hud
    $ b_phrase = renpy.random.choice(barman_phrases_defeat)
    barman "[b_phrase]"
    scene bg bar with fade
    show gg smile at left_pos
    show lira happy at right_pos
    show barmen scared at center_pos

    "Трактирщик падает на колени, вытирая кровь с разбитой губы."
    barman "Ты... ты сильный. Ладно. Ваша взяла. Таверна ваша."
    gg "Таверна наша."
    "Я смотрю на Лиру. Она улыбается, и в этой улыбке – надежда."

    jump tavern_owners_lira


# ---------- МЕТКА: tavern_duel_lose (поражение в дуэли) ----------
# Если игрок проиграл, ему даётся до 2 ретраев (с восстановлением здоровья до 25 у игрока и 35 у врага).
# Если все попытки исчерпаны – переход к концовке поражения.
label tavern_duel_lose:
    stop music
    play music music_bad_ending loop
    hide screen battle_hud

    $ b_phrase = renpy.random.choice(barman_phrases_victory)
    barman "[b_phrase]"

    if retry_count < 2:
        menu:
            "Попробовать ещё раз? (Осталось [2-retry_count] попыток)":
                jump tavern_duel_retry
            "Принять поражение.":
                jump ending_tavern_battle_lose
    else:
        "Ты использовал все шансы. Поражение окончательно."
        jump ending_tavern_battle_lose


# ---------- МЕТКА: tavern_duel_retry (ретрай дуэли) ----------
# Восстанавливает здоровье, сбрасывает счётчик раундов и флаг использования ключа.
label tavern_duel_retry:
    $ retry_count += 1
    play music music_battle loop
    "Ты встаёшь, стирая кровь. Бой продолжается! Ты чувствуешь, что силы на исходе, но не можешь сдаться."
    $ hp_player = 25
    $ hp_troll = 35
    $ battle_round = 0
    $ key_used = False
    jump tavern_duel_loop


# ---------- МЕТКА: tavern_owners_lira (финал с Лирой) ----------
# После победы над трактирщиком игрок и Лира становятся владельцами.
# Если привязанность и похоть достаточно высоки (>=3), то романтическая концовка.
# Иначе Лира уходит.
label tavern_owners_lira:
    scene bg bar with fade
    show gg smile at left_pos
    show lira stand at right_pos

    "Теперь мы хозяева. Я смотрю на бармена и чувствую, как власть меняет вкус."
    lira "Мне нравится."
    if girl_affinity >= 3 and lust >= 3:
        "Лира берёт меня за руку. Её пальцы – тёплые, и я чувствую, как они сжимают мои."
        lira "Хочу остаться с тобой навсегда."
        "Я вижу, как огонь отражается в её глазах. Она смотрит на меня так, как никто не смотрел."
        "Целуемся. Её губы – как первый глоток воды после долгого пути."
        jump ending_tavern_lira_romance                  # Романтическая концовка
    else:
        lira "Спасибо за всё. Но мне нужно идти."
        "Она уходит. Я смотрю на дверь, которая закрывается за ней, и чувствую пустоту."
        "Я остаюсь один, с этой таверной и с этим выбором, который сделал."
        jump end_chapter                                # Нейтральная концовка