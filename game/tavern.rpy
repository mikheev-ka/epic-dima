label tavern_checkers_lira:
    "Бармен достаёт поле. Я смотрю на девять клеток и чувствую, как весь мир сжимается до этой игры. Ставка – наша свобода."

    call play_checkers(30) from _call_play_checkers_1
    $ result = _return

    if result == "player":
        $ phrase = renpy.random.choice(tavern_win_phrases)
        barman "[phrase]"
        $ money += 30
        "Я выдыхаю. Лира сжимает мою руку. На один миг я чувствую, что всё будет хорошо. На один миг – пока трактирщик не скажет следующее слово."
        jump tavern_after_win_lira

    elif result == "ai":
        $ phrase = renpy.random.choice(tavern_lose_phrases)
