# ============================================================
# ПЕРСОНАЖИ, ПЕРЕМЕННЫЕ, ОБЩИЕ НАСТРОЙКИ
# ============================================================
#
# Этот файл содержит объявления всех игровых персонажей и переменных,
# используемых в игре. Все персонажи определены через `define`,
# переменные состояния – через `default` для поддержки сохранения.
# Комментарии поясняют назначение каждого элемента.
# ============================================================

# ---------- ПЕРСОНАЖИ ----------
# Каждый персонаж имеет уникальное имя, цвет текста (color) и цвет
# реплик (what_color). Цвета заданы в шестнадцатеричном формате.

# Главный герой – Дима. Игрок управляет им.
define gg = Character("Дима", color="#c8c8c8", what_color="#d0d0d0")

# Кирилл – друг или соперник, ключевой персонаж сюжета.
define kirill = Character("Кирилл", color="#6a9fb5", what_color="#b0c4de")

# Лира – загадочная девушка, потенциальная союзница или любовный интерес.
define lira = Character("Лира", color="#d4a5a5", what_color="#f0d0d0")

# Безымянный клиент (например, в таверне или на задании).
define client = Character("Клиент", color="#ffffff", what_color="#e0e0e0")

# Тролль – основной противник, с которым предстоит сражаться.
define troll = Character("Тролль", color="#b22222", what_color="#ff6666")

# Эрика – второстепенный персонаж, возможно, связана с магией или тайнами.
define erika = Character("Эрика", color="#da70d6", what_color="#f0d0f0")

# Продавщица – NPC в магазине или на рынке.
define seller = Character("Продавщица", color="#e0a060", what_color="#e0a060")

# Трактирщик – владелец таверны, источник информации.
define barman = Character("Трактирщик", color="#d4a060", what_color="#d4a060")

# Шериф – представитель закона, может влиять на сюжет.
define sheriff = Character("Шериф", color="#ccaa88", what_color="#ccaa88")

# Безымянный персонаж с пустым именем (используется для реплик без указания говорящего).
define unknown = Character("", color="#ffffff", what_color="#e0e0e0")

# Роза – проститутка, вероятно, второстепенный NPC с информацией.
define prostitute = Character("Роза", color="#ff66aa", what_color="#ff66aa")

# Цыган – мистический персонаж, может предсказывать судьбу.
define gypsy = Character("Цыган", color="#8b4513")

# Эффект вспышки (для переходов, например, в бою).
define flash = Fade(0.1, 0.0, 0.5, color="#fff")

# Несколько мужчин из толпы – используются для массовых сцен.
# Каждому задан уникальный цвет, чтобы различать реплики.
define man1 = Character("Мужик из толпы", color="#8b4513")
define man2 = Character("Мужик из толпы", color="#321a08")
define man3 = Character("Мужик из толпы", color="#a56231")
define man4 = Character("Мужик из толпы", color="#d0722e")
define man5 = Character("Мужик из толпы", color="#1e1107")
define man6 = Character("Мужик из толпы", color="#d77631")


# ---------- ПЕРЕМЕННЫЕ ----------
# Все переменные объявлены с `default`, чтобы их значения сохранялись
# между сессиями и сохранялись в файлах сохранения.

# Отношения с Кириллом (числовое значение, влияет на диалоги и концовки).
default relation_kirill = 0

# Флаг: раскрыт ли некий секрет (например, о прошлом героя).
default reveal_secret = False

# Флаг: у героя ничего нет (возможно, используется для проверки инвентаря).
default has_nothing = False

# Флаг: есть ли у героя ключ (для открытия дверей/сундуков).
default has_key = False

# Флаг: использован ли ключ (чтобы избежать повторного использования).
default key_used = False

# Флаг: есть ли у героя меч (основное оружие).
default has_sword = False

# Сила меча (уровень улучшения, влияет на урон).
default sword_power = 0

# Флаг: стала ли девушка (Лира) союзницей.
default girl_ally = False

# Привязанность девушки (шкала от 0 до максимума, влияет на отношения).
default girl_affinity = 0

# Флаг: побеждён ли тролль (завершён ли бой с ним).
default troll_defeated = False

# Флаг: успешно ли совершён побег (используется в сценах погони).
default escape_success = False

# Счётчик загадок (количество правильно решённых головоломок).
default riddle_score = 0

# Текущий путь/локация (используется для навигации).
default current_path = ""

# Выбор выхода (например, из локации).
default exit_choice = ""

# ----- Параметры боя с троллем -----
# Очки здоровья игрока.
default hp_player = 50

# Очки здоровья тролля.
default hp_troll = 80

# Урон, наносимый игроком (вычисляется динамически).
default player_damage = 0

# Урон, наносимый троллем (вычисляется динамически).
default troll_damage = 0

# Шанс уклонения (в процентах или долях).
default dodge_chance = 0

# Номер раунда в бою (для отслеживания ходов).
default battle_round = 0

# Действие с газом (для боевых сценариев, например, использование газовой атаки).
default gas_action_1 = ""
default gas_action_2 = ""

# ----- Финансы и ставки -----
# Количество денег у игрока.
default money = 0

# Ставка в играх (например, в карты или кости).
default game_stake = 5

# ----- Отношения с Лирой -----
# Флаг: помнит ли Лира что-то важное (ключевое для сюжета).
default lira_remember = False

# Доверие Лиры к герою в таверне (влияет на её решения).
default lira_tavern_trust = 0

# Флаг: присоединилась ли Лира к битве.
default lira_joined_battle = False

# ----- Расследование и улики -----
# Количество найденных улик (влияет на раскрытие тайны).
default clues_found = 0

# Флаг: есть ли у героя дневник (важный предмет).
default has_diary = False

# Флаг: пережил ли герой погоню (успешно скрылся).
default survived_pursuit = False

# ----- Характеристики героя (для системы морали/навыков) -----
# Храбрость – влияет на боевые и рискованные действия.
default bravery = 0

# Интеллект – влияет на решение загадок и логических задач.
default intellect = 0

# Похоть – влияет на романтические линии и некоторые реакции.
default lust = 0

# ----- Сюжетные флаги, связанные с Кириллом -----
# Флаг: Кирилл раскрыт (например, его истинная сущность).
default kirill_revealed = False

# Флаг: Кирилл побеждён в бою.
default kirill_defeated = False

# Флаг: игрок присоединяется к Кириллу (союз).
default player_joins_kirill = False

# Флаг: игрок убивает Кирилла.
default player_kills_kirill = False

# Флаг: Кирилл убеждён (переубеждён) игроком.
default kirill_persuaded = False

# Счётчик попыток переигрывания (для механики ретарти).
default retry_count = 0

# Флаг: второй этап игры (например, после поворотного момента).
default phase_two = False

# Флаг: Лира пожертвовала собой (трагический выбор).
default lira_sacrifice = False

# Флаг: известна ли слабость врага (используется в бою).
default known_weakness = False

# Кулдаун для тяжёлого оружия (количество ходов до повторного использования).
default heavy_cooldown = 0

# Флаг: использован ли финишёр (добивающий удар).
default finisher_used = False

# ----- Исследование локаций -----
# Флаги осмотра объектов в комнате/подземелье.
default examined_grille = False   # решётка
default examined_wall = False    # стена
default examined_straw = False   # солома
default examined_bucket = False  # ведро
default examined_crack = False   # трещина

# Время на QTE (quick time event) в секундах.
default qte_time = 1.5

# ----- Боевые параметры (общие) -----
# Максимальное здоровье игрока (для восстановления).
default max_hp_player = 50

# Максимальное здоровье тролля (может меняться в зависимости от сложности).
default max_hp_troll = 90

# Имя врага (может использоваться для динамических подписей).
default enemy_name = "Тролль"

# Статистика побед (для мини-игр или тренировочных боёв).
default player_wins = 0
default ai_wins = 0

# Номер раунда в текущем матче.
default round_number = 1

# Флаг: матч завершён.
default match_over = False

# Победитель матча (может быть "player" или "ai").
default match_winner = None