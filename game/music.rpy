# ============================================================
# МУЗЫКА И ЗВУКИ
# ============================================================
#
# Этот файл определяет все аудиоресурсы, используемые в игре:
# музыкальные темы (для разных локаций, настроений и событий)
# и звуковые эффекты (звонки, удары, дверь, ключ и т.д.).
# Каждая строка связывает имя аудиоканала (например, music_prolog)
# с путём к аудиофайлу в папке audio/.
#
# В Ren'Py определённые таким образом звуки можно проигрывать
# командами play music, play sound, play audio.
# Музыка обычно играет в фоновом режиме (канал music),
# а звуковые эффекты — в канале sound (они могут перебивать друг друга).
# ============================================================

# ----- Музыкальные темы (канал music) -----

# Музыка для пролога — меланхоличная, ночная, создаёт атмосферу
# одиночества и размышлений главного героя.
define audio.music_prolog = "audio/music_prolog.mp3"

# Музыка для сцен в городе (улицы, ночной город) — урбанистическая,
# с оттенком нуара, используется в прологе и других уличных сценах.
define audio.music_city = "audio/music_city.mp3"

# Напряжённая музыка для сцен с загадками, подозрением,
# исследованием тайных мест (архив, подземелье без боя).
define audio.music_suspense = "audio/music_suspense.mp3"

# Динамичная боевая музыка для схваток с троллем, Кириллом
# и другими врагами. Используется в циклах боя.
define audio.music_battle = "audio/music_battle.mp3"

# Мистическая, «сновидческая» музыка, которая играет перед сном
# главного героя или в переходах между реальностью и сном.
define audio.music_dream = "audio/music_dream.mp3"

# Светлая, торжественная музыка для хороших концовок (победа
# над врагом, романтический финал).
define audio.music_good_ending = "audio/good_ending.mp3"

# Траурная, мрачная музыка для плохих концовок (смерть героя,
# поражение, трагические исходы).
define audio.music_bad_ending = "audio/bad_ending.mp3"

# Звуковая тема с неясным назначением (возможно, используется
# для каких-то специфических эффектов или как заглушка).
define audio.music_zvuk = "audio/music_zvuk.mp3"

# Романтическая музыка для сцен с Лирой (при высоком уровне
# привязанности, в финальных сценах).
define audio.music_romance = "audio/music_romance.mp3"

# Музыка для сцен в таверне — шумная, народная, с оттенком
# средневековья/фэнтези.
define audio.music_tavern = "audio/tavern.mp3"

# Тема, связанная с персонажем Эрикой — возможно, мистическая
# или соблазнительная музыка.
define audio.music_erika = "audio/music_erika.mp3"

# Тяжёлая, гнетущая музыка для сцен насилия, изнасилования
# или особенно мрачных событий (например, сцена с троллем и Лирой).
define audio.music_rape = "audio/music_rape.mp3"

# Тёмная, зловещая музыка для подземелий, архивов и вообще
# мрачных локаций без активного боя.
define audio.music_dark = "audio/music_dark.mp3"

# Музыка для сцен оргий или группового секса (используется
# в некоторых взрослых сценах в таверне и участке).
define audio.music_orgy = "audio/music_orgy.mp3"

# Вероятно, музыка для полицейского участка (дублирует или
# является альтернативой music_police).
define audio.police = "audio/police.mp3"

# Музыка для ночных сцен (возможно, дополнительная атмосферная).
define audio.night = "audio/night.mp3"

# Основная музыка для сцен в полицейском участке.
define audio.music_police = "audio/music_police.mp3"


# ----- Звуковые эффекты (канал sound) -----

# Звук использования ключа (вспышка, щелчок) — применяется
# в бою или при открытии дверей.
define audio.key = "audio/key.mp3"

# Звук эякуляции — используется в сексуальных сценах.
define audio.cum = "audio/cum.mp3"

# Звук открывающейся или закрывающейся двери.
define audio.door = "audio/door.mp3"

# Звук телефонного звонка (входящий вызов).
define audio.phone = "audio/phone.mp3"

# Звук получения урона (удар, болезненный возглас) — возможно,
# используется в бою при попадании по игроку.
define audio.damage = "audio/damage.mp3"

# Звук стука в дверь (посылка с ключом в прологе).
define audio.knock = "audio/knock.mp3"

# Звук орального секса (минет) — используется в соответствующих
# сценах.
define audio.oral = "audio/oral.mp3"

# Звук секса (стандартный) — для сцен с Розой и других взрослых
# эпизодов.
define audio.fuck = "audio/fuck.mp3"

# Звук секса (приглушённый, тихий) — для более сдержанных сцен.
define audio.fuck_low = "audio/fuck_low.mp3"

# Звук толчка (удара или физического воздействия) — возможно,
# используется в драках.
define audio.Push = "audio/Push.mp3"