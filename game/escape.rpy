# ============================================================
# ПОБЕГ ИЗ ПОДЗЕМЕЛЬЯ (ОДИНОЧНЫЙ И СОВМЕСТНЫЙ)
# ============================================================
#
# Этот файл содержит все сцены побега из подземелья после того,
# как игрок справился с троллем (или прошёл загадки).
# Здесь представлены:
# - одиночный побег (escape_alone) – когда игрок один,
#   с выбором исследовать тайную комнату, убегать от голема,
#   решать загадку с символами (Огонь, Вода, Земля, Воздух),
#   и финальный выбор из четырёх проходов.
# - побег после загадок (escape_riddle) – когда игрок перехитрил
#   тролля с помощью загадок, и тролль показывает путь, но с
#   тремя туннелями и вариантами на кухне троллей.
# - совместный побег с Лирой (exit_choice_together) – аналогично
#   одиночному, но с учётом присутствия Лиры, её подсказок и
#   совместных действий.
#
# Все пути содержат ловушки, смертельные исходы и правильные
# варианты. Успешный побег ведёт к меткам after_escape_success
# или after_escape_together, где игрок выбирает дальнейший путь:
# таверна или участок шерифа.
# ============================================================

# ---------- ОДИНОЧНЫЙ ВЫХОД ----------
# Метка escape_alone – запускается, когда игрок покидает подземелье
# один (без Лиры) после победы над троллем или после загадок
# (если он не вернулся за ней).
label escape_alone:
    scene black with fade
    stop music
    play music music_suspense loop

    "Выход из клетки — как первый глоток воздуха после того, как тебя закопали. Коридор пахнет плесенью и тысячей лет одиночества."
    "Фонари моргают, как выдох умирающего. Впереди развилка. Справа — тишина, слева — эхо моих шагов, которое звучит как приговор."

    # ТАЙНАЯ КОМНАТА
    # Игрок может найти тайную комнату с дневником, который даёт подсказку
    # для загадки с символами. Если игрок открывает комнату, он получает
    # флаг has_diary = True и увеличивает количество улик.
    scene bg secret_room with fade
    "Одна плита выступает из стены, будто каменный палец, указывающий на дверь. Под ней слышно, как вода стекает по камню — как слёзы статуи."
    menu:
        "Открыть.":
            $ intellect += 1
            "Нажимаю — проход. Комната с книгами, на столе дневник. Я открываю его, и запах старой бумаги бьёт в нос, как пощёчина."
            "Запись: 'Огонь, Вода, Земля, Воздух — ключ к проходу. Порядок важен. Ошибёшься — погибнешь.'"
            gg "Без этого я не прочитаю символы на двери. Судьба — она как старый фильм: всегда есть подсказка, если знать, где искать."
            $ has_diary = True
            $ clues_found += 2
        "Пройти мимо.":
            $ bravery += 1
            "Не рискую. Слишком много ловушек, чтобы умереть в библиотеке — это было бы слишком литературно."
            $ has_diary = False

    # ПОБЕГ ОТ ГОЛЕМА — выбор теперь критичен
    # Игрок может спрятаться в нише (успех) или бежать (смерть).
    "Внезапно сзади грохот — каменный голем! Земля содрогается, как будто сам ад решил проверить, насколько крепко я держусь за жизнь. Красные глаза — два раскалённых угля — смотрят прямо на меня."
    menu:
        "Спрятаться в нише.":
            $ intellect += 1
            "Ныряю в нишу. Голем пробегает мимо, сотрясая пол. Сердце колотится так, что я слышу его даже сквозь рёбра. Он не заметил меня — слепой, как правосудие."
            $ survived_pursuit = True
        "Побежать.":
            $ bravery += 1
            scene bg trap_golem with fade
            "Бегу. Но голем быстрее. Его ноги дробят камень, как кувалда по черепу. Он настигает меня — и я чувствую удар, от которого мир разлетается на осколки."
            jump bad_end

    # ДВЕРЬ С СИМВОЛАМИ — только смерть от смыкания стен
    # Здесь игрок должен нажать символы в правильном порядке: Огонь, Вода, Земля, Воздух.
    # Если у него есть дневник (has_diary), он знает порядок.
    # Иначе — придётся угадывать, и любой неправильный выбор ведёт к смерти.
    "Выхожу к массивной двери. Четыре кнопки: Огонь, Вода, Земля, Воздух. Надпись: 'Тот, кто знает порядок, откроет путь. Ошибёшься — будешь погребён.'"
    "Прямо как в дешёвом детективе, только здесь вместо бумаги — камень, а ставка — моя шкура."
    scene bd zagadka with fade

    if has_diary:
        "Вспоминаю запись в дневнике: 'Огонь, Вода, Земля, Воздух — ключ к проходу. Порядок важен.'"
        "Теперь символы на двери обретают смысл. Без дневника я бы просто угадывал, как пьяный казино."
        "Надо выбрать правильную последовательность. Любая ошибка — и стены сожмутся, как удавка."

        # Вложенные меню для выбора последовательности.
        # Правильный порядок: Огонь → Вода → Земля → Воздух.
        # Любое отклонение ведёт к метке no_way_out (смерть от смыкания стен).
        menu:
            "Какой символ нажать первым?"
            "Огонь.":
                "Я нажимаю Огонь. Символ загорается тёплым светом. Второй?"
                menu:
                    "Вода.":
                        "Я нажимаю Воду. Символ вспыхивает синим. Третий?"
                        menu:
                            "Земля.":
                                "Я нажимаю Землю. Символ загорается зелёным. Четвёртый?"
                                menu:
                                    "Воздух.":
                                        "Я нажимаю Воздух. Дверь открывается с низким гулом, как вздох облегчения."
                                        $ intellect += 2
                                        jump escape_final_choice
                                    "Огонь.":
                                        "Стены содрогаются. Скрежет камня — как смех дьявола. Я пытаюсь отпрыгнуть, но проход сужается. Камень давит на грудь, ломает рёбра. Последнее, что я вижу — трещины на потолке, которые расходятся прямо надо мной. А потом — темнота."
                                        jump no_way_out
                                    "Вода.":
                                        "Стены приходят в движение. Камень трётся о камень — звук, от которого стынет кровь. Они смыкаются со всех сторон. Я зажат между плитами, как в тисках. Воздух выходит из лёгких. Мир гаснет."
                                        jump no_way_out
                                    "Земля.":
                                        "Стены начинают сжиматься. Камень давит на плечи, на голову. Потолок опускается. Я падаю на колени, но стены продолжают смыкаться. Последнее, что я слышу — хруст собственных костей."
                                        jump no_way_out
                            "Воздух.":
                                "Стены содрогаются. Камень начинает двигаться. Они смыкаются со всех сторон. Я пытаюсь вырваться, но проход сужается. Камень давит на грудь, и я теряю сознание."
                                jump no_way_out
                            "Огонь.":
                                "Стены приходят в движение. Сначала медленно, потом быстрее. Я бросаюсь к выходу, но каменные плиты уже смыкаются. Меня зажимает между ними. Свет гаснет."
                                jump no_way_out
                            "Вода.":
                                "Стены начинают сжиматься. Камень трещит под давлением. Они смыкаются надо мной, и я чувствую, как ломаются кости. Темнота поглощает меня."
                                jump no_way_out
                    "Земля.":
                        "Дверь не реагирует. Дрожь под ногами — стены начинают двигаться. Я пытаюсь бежать, но они смыкаются слишком быстро. Камень давит на меня со всех сторон. Я слышу, как трещат мои рёбра. Свет гаснет."
                        jump no_way_out
                    "Воздух.":
                        "Стены приходят в движение. Камень трётся о камень — звук, от которого стынет кровь. Они смыкаются надо мной. Я зажат между двумя плитами. Воздух выходит из лёгких. Мир исчезает."
                        jump no_way_out
            "Вода.":
                "Я нажимаю Воду. Символ гаснет. Стены содрогаются — ловушка! Они смыкаются со всех сторон. Камень давит на плечи, на голову. Потолок опускается. Я пытаюсь ползти, но слишком поздно. Камень сжимает меня. Темнота."
                jump no_way_out
            "Земля.":
                "Земля под ногами трясётся. Неправильный порядок. Стены приходят в движение. Я теряю равновесие и падаю. Каменные плиты смыкаются надо мной. Я слышу, как трещат мои кости. Свет гаснет."
                jump no_way_out
            "Воздух.":
                "Воздух становится тяжёлым. Дышать трудно. Неправильный порядок. Стены начинают сжиматься. Я задыхаюсь. Камень давит на грудь. Я чувствую, как лопаются сосуды в глазах. Мир исчезает в темноте."
                jump no_way_out
    else:
        "Я не знаю последовательности. Символы на двери — как зашифрованное послание, которое я не могу прочитать. Дневник мог бы помочь — но я оставил его там, где он должен был остаться."
        "Придётся угадывать. Шанс один из двадцати четырёх. Как в русской рулетке, только пуль больше."
        # Те же меню, но без подсказок, и все неправильные варианты ведут к no_way_out.
        # Единственный правильный путь — Огонь→Вода→Земля→Воздух.
        menu:
            "Какой символ нажать первым?"
            "Огонь.":
                "Нажимаю Огонь..."
                menu:
                    "Вода.":
                        "Нажимаю Воду..."
                        menu:
                            "Земля.":
                                "Нажимаю Землю..."
                                menu:
                                    "Воздух.":
                                        "Нажимаю Воздух — дверь открывается! Повезло, как в последнем кадре плохого фильма."
                                        $ intellect += 2
                                        jump escape_final_choice
                                    "Огонь.":
                                        "Стены содрогаются. Скрежет камня — как смех дьявола. Камень давит на грудь. Я пытаюсь крикнуть, но воздух уже выходит из лёгких. Темнота."
                                        jump no_way_out
                                    "Вода.":
                                        "Стены приходят в движение. Камень трётся о камень. Они смыкаются со всех сторон. Я зажат между плитами. Мир гаснет."
                                        jump no_way_out
                                    "Земля.":
                                        "Стены начинают сжиматься. Камень давит на плечи, на голову. Потолок опускается. Последнее, что я слышу — хруст собственных костей."
                                        jump no_way_out
                            "Воздух.":
                                "Стены содрогаются. Они смыкаются со всех сторон. Я пытаюсь вырваться, но проход сужается. Камень давит на грудь. Свет гаснет."
                                jump no_way_out
                            "Огонь.":
                                "Стены приходят в движение. Я бросаюсь к выходу, но каменные плиты уже смыкаются. Меня зажимает между ними."
                                jump no_way_out
                            "Вода.":
                                "Стены начинают сжиматься. Камень трещит под давлением. Они смыкаются надо мной. Темнота поглощает меня."
                                jump no_way_out
                    "Земля.":
                        "Дверь не реагирует. Стены начинают двигаться. Я пытаюсь бежать, но они смыкаются слишком быстро. Камень давит на меня со всех сторон. Свет гаснет."
                        jump no_way_out
                    "Воздух.":
                        "Стены приходят в движение. Они смыкаются надо мной. Я зажат между двумя плитами. Воздух выходит из лёгких. Мир исчезает."
                        jump no_way_out
            "Вода.":
                "Я нажимаю Воду. Символ гаснет. Стены содрогаются — ловушка! Они смыкаются со всех сторон. Камень давит на плечи, на голову. Потолок опускается. Темнота."
                jump no_way_out
            "Земля.":
                "Земля под ногами трясётся. Стены приходят в движение. Я теряю равновесие и падаю. Каменные плиты смыкаются надо мной. Я слышу, как трещат мои кости. Свет гаснет."
                jump no_way_out
            "Воздух.":
                "Воздух становится тяжёлым. Дышать трудно. Стены начинают сжиматься. Я задыхаюсь. Камень давит на грудь. Мир исчезает в темноте."
                jump no_way_out


# ---------- ФИНАЛЬНЫЙ ВЫБОР: ЧЕТЫРЕ ПУТИ ----------
# После открытия двери игрок оказывается в зале с четырьмя проходами.
# Три из них ведут к смерти (ловушки: огонь, вода, голем), один правильный — вниз.
label escape_final_choice:
    stop music
    play music music_suspense loop
    scene bg escape_chamber with fade

    "За дверью — просторный зал. Четыре прохода. Четыре тени, четыре обещания. Стены покрыты символами, похожими на те, что были на ключе."
    "Я не понимаю их языка, но чувствую: каждый путь — это выбор между жизнью и смертью. Как в старой игре, где каждое решение ведёт к новой концовке."
    "Четыре прохода. Четыре лица одной темницы. Я должен выбрать. И если ошибусь — не будет второго шанса."

    menu:
        "Пойти налево. Там мерцает свет.":
            jump escape_death_1
        "Пойти направо. Оттуда доносится шум воды.":
            jump escape_death_2
        "Пойти прямо. Там пахнет свежим воздухом.":
            jump escape_death_3
        "Пойти вниз. Туда, где темно, но слышен ветер.":
            jump escape_success

# ---------- ЛОВУШКИ ----------
# Три метки смерти для неправильных проходов.
label escape_death_1:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Я иду на свет. Он тёплый, жёлтый — как уличный фонарь в дождливую ночь. Он манит меня, обещая тепло и безопасность. Моё сердце успокаивается. Я почти улыбаюсь — впервые за долгое время."
    scene bg trap_flame with fade
    "Но когда я делаю шаг вперёд, пол уходит из-под ног. Свет оказывается не фонарём, а пламенем. Оно поднимается мне навстречу, обжигая лицо, выжигая глаза. Я падаю в огненную яму."
    "Я слышу треск собственной кожи. Кричу, но вместо голоса — только хрип. Пламя пожирает меня, и я понимаю, что это ад, который я сам выбрал. Свет не всегда спасение. Иногда это просто ловушка для мотыльков."
    
    pause 1.0
    "Ты ошибся. Свет не всегда спасение. Иногда это просто ловушка для мотыльков."
    jump bad_end

label escape_death_2:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Я иду на шум воды. Она обещает чистоту, прохладу, избавление от пыли и пота. Я вхожу в туннель — и вода начинает подниматься."
    scene bg trap_water with fade
    "Сначала она лижет мои ботинки, потом поднимается до колен. Я думаю: «Ничего страшного, я умею плавать». Но вода становится всё быстрее, она заливает грудь, шею."
    "Я пытаюсь плыть, но течение тянет меня вниз. Стены смыкаются, и я понимаю, что это не река — это капкан. Вода заполняет лёгкие. Я тону не в воде — в своей собственной надежде."
    "В последний миг я вижу, как вода становится красной — это моя кровь смешивается с ней. Вода утоляет жажду. Но иногда — только чтобы ты мог почувствовать, как умираешь."
    
    pause 1.0
    jump bad_end

label escape_death_3:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Я иду на запах свежего воздуха. Он пахнет лесом, травой, жизнью. Туннель расширяется. Я вижу небо — голубое, настоящее. Я бегу к нему, и стены начинают содрогаться."
    scene bg trap_golem with fade
    "Я почти у выхода — но каменный голем поднимается из земли и загораживает путь. Его глаза горят зелёным, он смотрит на меня, как на букашку. Я бросаюсь вперёд, но он хватает меня за горло."
    "Пальцы смыкаются на моей шее. Я слышу хруст собственных позвонков. Свобода была так близко. Я чувствовал её запах — но она ускользнула. Воздух был настоящим. Но путь был ложным."
    
    pause 1.0
    jump bad_end

# Правильный путь — вниз.
label escape_success:
    stop music
    play music music_good_ending loop
    "Я иду вниз. Туда, где темно, но слышен ветер. Я доверяю не глазам — а звуку. Каменные ступени ведут вглубь, но воздух становится свежее."
    "Я слышу ветер — не подземный, а настоящий. Ступени заканчиваются. Передо мной — расщелина. За ней — лес. Солнце. Жизнь."
    "Я делаю шаг и чувствую, как дождь касается моего лица. Я вышел. Я вырвался из этого каменного ада."
    scene bg forest_clearing with fade
    show gg tired at center_pos
    "Я выхожу на поверхность. Дождь стихает. Небо чистое. Я жив. Я выбрался. В кармане — ржавый ключ. Он больше не тёплый. Он выполнил свою работу."
    "Я смотрю назад на вход в пещеру. Он выглядит как обычная расщелина. Как будто никогда не было никакого подземелья."
    jump after_escape_success


# ---------- УНИКАЛЬНЫЙ ПОБЕГ – ТРОЛЛЬ-ПРОВОДНИК (ПОСЛЕ ЗАГАДОК) ----------
# Эта метка запускается, если игрок прошёл загадки и решил уйти
# (не возвращаясь за Лирой). Тролль, выполняя обещание, показывает
# три туннеля, и игрок должен выбрать правильный.
label escape_riddle:
    stop music
    play music music_suspense loop
    scene bg dungeon_corner with fade   # вместо scene black
    "Слышу шаги за спиной. Тяжёлые, медленные. Тролль. Он нависает надо мной, как тень от облака в пасмурный день."
    show troll troll_normal at center_pos
    troll "Ты обманул Тролля. Тролль держит слово. Я покажу тебе путь."
    "Он подходит к стене и нажимает на камень. Стена сдвигается — открывается узкий проход, откуда тянет холодом."
    troll "Там три пути. Один ведёт к свободе. Два других — к смерти. Я не скажу, какой из них правильный. Ты сам должен выбрать."
    "Тролль исчезает в темноте. Я остаюсь один. Как в конце фильма, когда герой остаётся один на один с выбором."
    scene bg secret_passage with fade
    show gg thinking at center_pos
    "Я вхожу в проход. Стены влажные, воздух тяжёлый. Через несколько минут я выхожу к развилке. Три туннеля. Три обещания."
    menu:
        "Пойти в полную темноту. Там ничего не видно и не слышно.":
            jump riddle_path_dark
        "Пойти в темноту, но слышен звук воды.":
            jump riddle_path_water
        "Пойти к свету факелов. Оттуда пахнет едой.":
            jump riddle_path_fire

# ---------- ПУТИ В ТУННЕЛЯХ (ПОСЛЕ ЗАГАДОК) ----------
# Три варианта: тёмный путь (обрыв), путь воды (утопление), путь огня (кухня троллей).
# Только путь огня (riddle_path_fire) даёт шанс на выживание (через дополнительные выборы).
label riddle_path_dark:
    stop music
    play music music_dark loop
    scene black with fade
    "Я делаю шаг в темноту. Ни звука, ни света, ни запаха. Только воздух — холодный, сырой. Я иду наощупь, держась за стену. Камень влажный, скользкий."
    "Я чувствую, как он вибрирует от моих шагов. Я иду. Минуту. Две. Три. Стена заканчивается. Я делаю шаг вперёд — и чувствую пустоту под ногами. Это был обрыв."
    "Я лечу вниз, разбиваясь о камни. Темнота поглощает меня."
    jump bad_end

label riddle_path_water:
    stop music
    play music music_dark loop
    scene black with fade
    "Я иду на звук воды. Она журчит где-то впереди — мягко, успокаивающе. Я думаю: «Это выход. Река. Свобода». Туннель начинает опускаться. Вода появляется у моих ног — холодная, прозрачная."
    "Я иду дальше. Вода поднимается до колен. Течение становится сильнее. Вода уже по пояс. Я пытаюсь плыть, но течение тянет меня вниз. Я хватаюсь за стену — она скользкая. Мои пальцы соскальзывают."
    "Вода заливает рот. Я глотаю её — холодную, безвкусную. Я пытаюсь крикнуть, но вместо крика — только пузыри. Вода заполняет лёгкие. Я чувствую, как мир гаснет. Я понял это слишком поздно: вода не выводит к свободе. Она уводит вниз."
    scene bg trap_water with fade
    pause 1.0
    "Вода заполняет лёгкие. Я чувствую, как мир гаснет. Я понял это слишком поздно: вода не выводит к свободе. Она уводит вниз."
    jump bad_end

# Путь огня — кухня троллей. Здесь есть три варианта действий:
# - пробраться незаметно (смерть),
# - освободить пленных и устроить бунт (смерть),
# - притвориться слугой (успех).
label riddle_path_fire:
    stop music
    play music music_tavern loop
    scene bg troll_cave_kitchen with fade
    "Я иду на свет факелов. Запах еды становится всё сильнее. Я выхожу в огромную пещеру. Здесь — кухня троллей. Посередине — гигантский котёл, под которым пылает огонь. В нём варится что-то, от чего у меня кружится голова."
    "Рядом — разделочные столы. На них — кости, шкуры, потроха. В углу — клетка с пленными. Они смотрят на меня. В их глазах — страх и надежда. Тролли-повара. Двое. Они не замечают меня — они увлечены готовкой. Один помешивает варево, другой режет мясо."
    "Я могу попытаться пройти мимо. Но я чувствую, что это не единственный вариант."
    menu:
        "Попытаться незаметно пройти мимо кухни.":
            jump riddle_kitchen_sneak
        "Попытаться освободить пленных и устроить бунт.":
            jump riddle_kitchen_revolt
        "Попытаться выдать себя за слугу троллей.":
            jump riddle_kitchen_servant

# ---------- ВАРИАНТЫ НА КУХНЕ (ПОСЛЕ ЗАГАДОК) ----------
# Все варианты, кроме слуги, ведут к смерти.
label riddle_kitchen_sneak:
    "Я прижимаюсь к стене. Двигаюсь медленно, бесшумно. Прохожу мимо котла. Пар обжигает лицо. Я чувствую запах варева — и меня тошнит."
    "Тролль с ножом поворачивается ко мне. Я замираю."
    # Теперь даже с ключом – смерть
    "Он замечает меня. Рычит и хватает меня за шкирку. Я пытаюсь вырваться, но его хватка мёртвая."
    troll "Ты думал, я глупый? Тролль слышал твоё сердце. Оно стучало как барабан."
    "Меня бросают в котёл. Я чувствую жар — и всё заканчивается."
    jump bad_end

label riddle_kitchen_revolt:
    "Я бегу к клетке. Пленные смотрят на меня с ужасом. Я хватаю дубину и бью по замку. Замок не поддаётся. Я бью снова — и он разлетается."
    "Пленные выбегают. Они хватают всё, что попадётся под руку: кости, ножи, камни. Тролли поворачиваются. Они не ожидали нападения. Начинается драка. В пещере — хаос."
    menu:
        "Вступить в бой вместе с пленными.":
            "Я хватаю нож и бросаюсь на тролля. Мы сражаемся. Я чувствую, как мои руки горят от напряжения. Пленные бьют троллей чем попало."
            "В пещере — грохот, крики, огонь. Один тролль падает. Второй пытается убежать, но его ловят. Я стою среди поверженных врагов."
            "Но внезапно из тени появляется ещё один тролль — тот, что был стражем. Он смотрит на меня с яростью. Я не успеваю среагировать — его дубина сбивает меня с ног. Мир гаснет."
            jump bad_end
        "Использовать момент и сбежать, пока тролли заняты.":
            "Я бегу. Пленные остаются в клетке. Их крики тонут в шуме битвы. Я выбегаю из пещеры. Слышу за спиной грохот — и понимаю, что я сделал."
            "Я спас себя. Но выход — тупик. Я попадаю в зал, где нет дверей, только глухая стена. Сзади слышны шаги — тролль идёт за мной."
            "Я зажат в углу. Выбора нет. Он схватывает меня и сворачивает шею."
            jump bad_end

label riddle_kitchen_servant:
    "Я выпрямляюсь и прохожу мимо троллей с невозмутимым видом. Один из них смотрит на меня. Я улыбаюсь и киваю. Тролль моргает. Он думает, что я — новый слуга."
    "Я прохожу мимо котла. Забираю кусок мяса со стола и иду дальше. Тролль смотрит на меня, но ничего не говорит. Я выхожу из пещеры."
    scene bg forest_clearing with fade
    show gg tired at center_pos
    "Я стою на склоне холма. В руке — кусок мяса. Я выжил. Благодаря наглости."
    jump after_escape_success

# (метка riddle_kitchen_success больше не используется, оставлена для совместимости, но не вызывается)
label riddle_kitchen_success:
    "Этот путь больше не доступен. См. riddle_kitchen_servant."
    jump after_escape_success


# ---------- ВЫХОД ВМЕСТЕ С ЛИРОЙ ----------
# Эта метка запускается, если игрок прошёл подземелье вместе с Лирой
# и они вместе достигают выхода.
label exit_choice_together:
    scene bg dungeon_exit_final with fade
    show gg confused at left_pos
    show lira stand at right_pos
    lira "Ты не бросил меня. Это больше, чем я ожидала."
    gg "Мы команда. Одиночество — плохой напарник."

    # Тайная комната с Лирой
    scene bg tunnel1 with fade
    lira "Подожди, здесь что-то есть."
    "Она находит скрытую дверь. Её пальцы скользят по камню, как по старой коже."
    menu:
        "Открыть.":
            $ intellect += 1
            $ girl_affinity += 1
            "В комнате — дневник. Запись: 'Огонь, Вода, Земля, Воздух — порядок, который открывает путь. Любая ошибка — смерть.'"
            gg "Вот последовательность. Без этого мы не пройдём. Судьба иногда подкидывает подсказки, даже когда кажется, что она против тебя."
            $ clues_found += 2
            $ has_diary = True
        "Продолжить.":
            $ bravery += 1
            $ girl_affinity -= 1
            "Не рискуем. Я чувствую, что Лира разочарована. Но иногда осторожность — единственный способ остаться в живых."
            $ has_diary = False

    # Побег от голема — совместный выбор
    "Грохот — голем! Я слышу его шаги за спиной. Лира смотрит на меня с ужасом."
    menu:
        "Спрятаться в проходе.":
            $ intellect += 1
            $ girl_affinity += 1
            "Втягиваем Лиру в лаз. Голем проходит мимо. Мы задерживаем дыхание. Он не заметил нас — каменный идиот."
            $ survived_pursuit = True
        "Побежать.":
            $ bravery += 1
            $ girl_affinity -= 1
            scene bg trap_golem with fade
            "Бежим, но голем слишком быстр. Он догоняет нас. Я пытаюсь защитить Лиру — но безуспешно."
            jump bad_end

    # Дверь с символами — только смерть от смыкания стен
    scene bd zagadka with fade
    "Мы выходим к массивной двери. На ней — четыре символа: Огонь, Вода, Земля, Воздух. Надпись: 'Тот, кто знает порядок, откроет путь. Ошибёшься — будешь погребён.'"
    lira "Это та самая дверь. Я видела её во сне. Нам нужно нажать символы в правильном порядке."

    if has_diary:
        "Я вспоминаю запись в дневнике: 'Огонь, Вода, Земля, Воздух — порядок, который открывает путь.'"
        "Лира кивает. Она тоже это помнит."
        lira "Огонь — начало. Затем Вода. Потом Земля. И Воздух — последний."

        # Вложенные меню для совместного выбора. Правильный порядок тот же.
        # Любое отклонение ведёт к exit_crushed.
        menu:
            "Какой символ нажать первым?"
            "Огонь.":
                "Я нажимаю Огонь. Символ загорается тёплым светом."
                lira "Правильно. Теперь второй."
                menu:
                    "Вода.":
                        "Я нажимаю Воду. Символ вспыхивает синим."
                        lira "Хорошо. Третий — Земля."
                        menu:
                            "Земля.":
                                "Я нажимаю Землю. Символ загорается зелёным."
                                lira "Последний — Воздух!"
                                menu:
                                    "Воздух.":
                                        "Я нажимаю Воздух. Дверь открывается с низким гулом."
                                        $ intellect += 2
                                        $ girl_affinity += 1
                                        "Лира улыбается. Мы сделали это вместе."
                                        jump exit_final_choice
                                    "Огонь.":
                                        "Стены содрогаются. Я слышу, как камень начинает двигаться. Лира кричит, но стены уже смыкаются. Я пытаюсь её прикрыть, но камень давит на нас со всех сторон. Мы зажаты между плитами. Её пальцы впиваются в мою руку — и я чувствую, как они слабеют. Темнота."
                                        jump exit_crushed
                                    "Вода.":
                                        "Стены приходят в движение. Лира смотрит на меня с ужасом. Мы пытаемся вырваться, но каменные плиты смыкаются. Я чувствую, как её тело прижимается ко мне, а потом — как оно становится тяжёлым. Камень сжимает нас. Мир гаснет."
                                        jump exit_crushed
                                    "Земля.":
                                        "Стены начинают сжиматься. Лира кричит, но я не могу ничего сделать. Камень давит на нас. Я чувствую, как ломаются её рёбра. Она затихает. И я тоже."
                                        jump exit_crushed
                            "Воздух.":
                                "Стены содрогаются. Лира пытается меня оттолкнуть к выходу, но стены уже смыкаются. Мы зажаты между камнем и камнем. Я слышу её крик — и он обрывается. Темнота."
                                jump exit_crushed
                            "Огонь.":
                                "Стены приходят в движение. Лира падает, и я пытаюсь её поднять, но каменные плиты уже смыкаются. Мы оказываемся зажаты между ними. Она смотрит на меня в последний раз — и я вижу, как гаснет свет в её глазах."
                                jump exit_crushed
                            "Вода.":
                                "Стены начинают сжиматься. Лира вскрикивает, но её голос перекрывает скрежет камня. Мы зажаты между плитами. Я чувствую, как её дыхание замирает. Темнота."
                                jump exit_crushed
                    "Земля.":
                        "Дверь не реагирует. Мы слышим треск камня — стены начинают двигаться. Лира кричит: 'Неправильно! Огонь, Вода, Земля, Воздух — в таком порядке!' Но уже поздно. Каменные плиты смыкаются. Мы зажаты. Я чувствую, как её пальцы сжимают мою руку — и разжимаются."
                        jump exit_crushed
                    "Воздух.":
                        "Стены приходят в движение. Мы в ловушке. Лира смотрит на меня с ужасом, но я не могу ничего сделать. Камень смыкается. Я чувствую, как её тело прижимается ко мне — и перестаёт двигаться. Темнота."
                        jump exit_crushed
            "Вода.":
                "Я нажимаю Воду. Символ гаснет. Стены содрогаются. Лира кричит: 'Нет! Огонь должен быть первым!' Но стены уже смыкаются. Мы зажаты между каменными плитами. Я чувствую, как она прижимается ко мне, а потом — как её тело становится тяжёлым. Мир гаснет."
                jump exit_crushed
            "Земля.":
                "Земля под ногами трясётся. Лира теряет равновесие. Я пытаюсь её удержать, но стены приходят в движение. Она шепчет: 'Огонь, Вода, Земля, Воздух! Огонь — первый!' Но каменные плиты уже смыкаются. Мы зажаты. Я чувствую, как её дыхание замирает. Темнота."
                jump exit_crushed
            "Воздух.":
                "Воздух становится тяжёлым. Я чувствую, как задыхаюсь. Лира хрипит: 'Не в этом порядке! Огонь, Вода, Земля, Воздух!' Но стены уже сомкнулись. Мы зажаты между камнем и камнем. Я чувствую, как её тело прижимается ко мне — и перестаёт двигаться. Темнота."
                jump exit_crushed
    else:
        "Я не знаю последовательности. Дневник остался в той комнате."
        lira "Я помню только, что Огонь — это начало. Дальше — я не уверена."
        "Нам придётся угадывать. Если ошибёмся — смерть."
        # Меню угадывания – только правильный порядок ведёт к exit_final_choice.
        menu:
            "Какой символ нажать первым?"
            "Огонь.":
                "Я нажимаю Огонь. Символ загорается."
                lira "Огонь — правильный. Теперь... я не уверена."
                menu:
                    "Вода.":
                        "Я нажимаю Воду. Символ загорается синим."
                        lira "Земля должна быть третьей! А Воздух — последним."
                        menu:
                            "Земля.":
                                "Я нажимаю Землю. Символ загорается зелёным."
                                lira "Теперь Воздух!"
                                menu:
                                    "Воздух.":
                                        "Я нажимаю Воздух. Дверь открывается."
                                        $ intellect += 1
                                        $ girl_affinity += 1
                                        "Лира выдыхает. 'Я думала, мы не справимся.'"
                                        jump exit_final_choice
                                    "Огонь.":
                                        "Стены содрогаются. Лира кричит, но камень уже смыкается. Мы зажаты между плитами. Я чувствую, как её тело прижимается ко мне — и замирает. Темнота."
                                        jump exit_crushed
                                    "Вода.":
                                        "Стены приходят в движение. Лира падает, и я пытаюсь её поймать, но каменные плиты уже смыкаются. Мы зажаты. Я слышу её последний вздох."
                                        jump exit_crushed
                                    "Земля.":
                                        "Стены начинают сжиматься. Лира смотрит на меня с ужасом. Я чувствую, как камень давит на нас. Её пальцы сжимают мою руку — и разжимаются. Темнота."
                                        jump exit_crushed
                            "Воздух.":
                                "Стены содрогаются. Мы ошиблись. Камень смыкается. Лира кричит, но её голос перекрывает скрежет камня. Мы зажаты. Я чувствую, как она перестаёт дышать."
                                jump exit_crushed
                            "Огонь.":
                                "Стены приходят в движение. Мы пытаемся бежать, но поздно. Каменные плиты смыкаются. Я чувствую, как тело Лиры прижимается ко мне — и становится неподвижным. Темнота."
                                jump exit_crushed
                            "Вода.":
                                "Стены начинают сжиматься. Мы зажаты между камнем и камнем. Лира вскрикивает, а потом затихает. Темнота."
                                jump exit_crushed
                    "Земля.":
                        "Стены содрогаются. Мы ошиблись. Камень смыкается. Лира кричит, но я не могу ничего сделать. Мы зажаты. Я чувствую, как её дыхание замирает."
                        jump exit_crushed
                    "Воздух.":
                        "Стены приходят в движение. Мы пытаемся отступить, но проход закрывается. Каменные плиты смыкаются. Мы зажаты. Я слышу её последний вздох."
                        jump exit_crushed
            "Вода.":
                "Стены содрогаются. Мы ошиблись. Камень смыкается. Лира падает, и я слышу её крик — он обрывается. Темнота."
                jump exit_crushed
            "Земля.":
                "Стены приходят в движение. Мы ошиблись. Каменные плиты смыкаются. Лира пытается защитить меня, но камень слишком силён. Я чувствую, как её тело замирает. Темнота."
                jump exit_crushed
            "Воздух.":
                "Стены начинают сжиматься. Мы ошиблись. Камень смыкается. Лира смотрит на меня в последний раз — и я вижу, как гаснет свет в её глазах. Темнота."
                jump exit_crushed

# ---------- СМЕРТЬ ОТ СМЫКАНИЯ СТЕН (СОВМЕСТНАЯ) ----------
label exit_crushed:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Камень смыкается. Я чувствую, как стены и потолок сжимаются — сначала медленно, потом всё быстрее."
    "Лира рядом, я слышу её дыхание — оно становится всё тише. Она не кричит. Она просто сжимает мою руку. Я чувствую, как её пальцы сжимают мои — и разжимаются."
    "Камень давит на грудь, ломает рёбра. Я слышу, как трещат кости. Мои? Её? Я уже не понимаю. Свет гаснет. Я чувствую, как её тело прижимается ко мне — и перестаёт двигаться."
    "А потом — ничего. Только тьма, холод и тишина."
    scene bg crushed with fade
    pause 1.0
    "Стены погребли нас заживо. Мы ошиблись — и это стоило нам всего."
    jump bad_end

# ---------- СОВМЕСТНЫЙ ФИНАЛЬНЫЙ ВЫБОР ----------
# После открытия двери игрок с Лирой оказываются в зале с четырьмя проходами.
# В зависимости от привязанности Лиры (girl_affinity) она даёт разные подсказки.
# Правильный путь — вниз (если girl_affinity >= 2, Лира советует его).
label exit_final_choice:
    stop music
    play music music_suspense loop
    scene bg escape_chamber with fade
    "За дверью — просторный зал. Четыре прохода. Четыре тени, четыре обещания."
    "Лира берёт меня за руку. Её пальцы холодные, но она не дрожит."

    # Подсказки Лиры в зависимости от уровня привязанности
    if girl_affinity >= 3:
        lira "Я чувствую правильный путь. Он внизу. Я слышу голос — он зовёт нас. Это не ловушка."
    elif girl_affinity >= 2:
        lira "Я не уверена, но мне кажется, что правильный путь — тот, где пахнет свежестью. Свет и звуки могут обмануть, но запах — нет."
    else:
        lira "Я не знаю, куда идти. Ты выбираешь. Я просто пойду за тобой."

    menu:
        "Пойти налево. Там мерцает свет.":
            jump exit_death_1
        "Пойти направо. Оттуда доносится эхо.":
            jump exit_death_2
        "Пойти прямо. Я чувствую ветер.":
            jump exit_death_3
        "Пойти вниз, как советует Лира." if girl_affinity >= 2:
            jump exit_success

# ---------- СМЕРТИ (СОВМЕСТНЫЕ) ----------
# Три ловушки для совместного побега (огненная яма, вода, голем).
label exit_death_1:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Мы идём на свет. Он манит нас, обещая безопасность. Лира идёт рядом, и я чувствую её руку в своей."
    scene bg trap_flame with fade
    "Но свет оказывается пламенем. Пол уходит из-под ног. Мы падаем вместе. Я успеваю услышать её крик — и он обрывается. Пламя пожирает нас."
    "В последний миг я вижу её лицо — оно искажено болью. Я не смог её защитить. Мы умираем вместе в огне."
    
    pause 1.0
    jump bad_end

label exit_death_2:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Мы идём на эхо. Оно звучит как голос — чей-то знакомый. Лира напрягается. Она говорит: 'Это не настоящий голос. Это ловушка.'"
    scene bg trap_water with fade
    "Но я уже слишком далеко. Вода поднимается. Она заливает туннель, и мы пытаемся плыть, но течение слишком сильное."
    "Лира уходит под воду. Я пытаюсь достать её — но безуспешно. Вода заполняет мои лёгкие. Я тону, глядя, как она исчезает в глубине."
    
    pause 1.0
    jump bad_end

label exit_death_3:
    stop music
    play music music_bad_ending loop
    scene black with fade
    "Мы идём на ветер. Он пахнет лесом, свободой. Я почти верю, что это выход."
    scene bg trap_golem with fade
    "Но стены начинают содрогаться. Каменный голем вырывается из-под земли. Лира пытается защитить меня. Она бросается вперёд, но голем слишком силён."
    "Я слышу хруст её костей — и кричу. Но голос тонет в грохоте камня. Голем сжимает меня, и мир гаснет."
    
    pause 1.0
    jump bad_end

# Правильный совместный побег — вниз.
label exit_success:
    stop music
    play music music_good_ending loop
    "Мы идём вниз. Ступени ведут в темноту, но Лира идёт уверенно. Она говорит: 'Я знаю. Я чувствую.'"
    "Она ведёт меня. Её рука — моя нить в лабиринте. Внизу — дверь. Старая, каменная. На ней — тот же символ, что был на ключе."
    "Я достаю ключ. Он подходит. Дверь открывается."
    scene bg forest_clearing with fade
    show gg tired at left_pos
    show lira smile at right_pos
    "Мы выходим на поверхность. Солнце. Лес. Небо."
    lira "Мы сделали это. Мы живы."
    gg "Благодаря тебе."
    lira "Благодаря нам."
    jump after_escape_together


# ---------- ДРУГИЕ ВСПОМОГАТЕЛЬНЫЕ МЕТКИ ----------
# Метка no_way_out – смерть от смыкания стен (одиночный вариант).
label no_way_out:
    stop music
    play music music_bad_ending loop
    scene bg dungeon_cell_real with fade
    show gg fall3 at center_pos
    "Тупик. Стены смыкаются. Я слышу, как камень трётся о камень — звук, от которого стынет кровь."
    "Я пытаюсь найти лазейку, но проход сужается с каждой секундой. Камень давит на грудь, ломает рёбра. Я чувствую, как воздух выходит из лёгких."
    "Темнота сгущается — и я понимаю, что это конец. Меня погребли заживо. Никто не найдёт моё тело. Я останусь здесь навсегда."
    scene black with fade
    jump bad_end

# Метка trap_death – смерть от ловушки с кольями (используется, например, если игрок наступает на плиту).
# Сейчас не используется, но оставлена для возможного расширения.
label trap_death:
    stop music
    play music music_bad_ending loop
    scene bg trap with fade
    show gg fall4 at center_pos
    "Я наступаю на плиту — и мир уходит из-под ног. Я лечу вниз. Ветер свистит в ушах."
    "Я вижу, как стены проносятся мимо — серые, влажные, бесконечные. Внизу — колья. Острые, как зубы зверя."
    "Я успеваю подумать: 'Глупо. Всё это было глупо.' А потом — резкая боль, и темнота."
    scene black with fade
    jump bad_end

# Метка too_late_for_lira – если игрок решает вернуться за Лирой после загадок,
# но приходит слишком поздно и видит, как тролли насилуют её, затем его самого ловят.
label too_late_for_lira:
    stop music
    play music music_bad_ending loop
    scene bg dungeon_cell_real1 with fade
    show gg angry at center_pos
    with dissolve
    "Я бегу. Ноги не чувствуют камня. Лёгкие горят, сердце колотится где-то в горле. Я должен успеть. Я должен её спасти."
    "Коридор становится темнее, и я слышу звуки – сначала далёкие, потом всё ближе. Крики. Рычание. Что-то влажное, что шлёпает по камню."
    "Бегу к камере Лиры. Но становится очень шумно и мрачно. Свет факелов меркнет, как будто кто-то выключает мир по кусочкам."
    stop music
    pause 0.5

    "Я останавливаюсь. Воздух выходит из лёгких, как будто меня ударили в грудь. В щели между камнями я вижу..."

    # Сцены насилия над Лирой (описаны, но код не изменяем)
    scene bg lira troll_gang1 with fade
    play music music_orgy loop volume 0.9
    lira "Нет! Пожалуйста, не надо! Отпустите меня! Я умоляю!"
    "Куча тварей разрывали девушку, с которой я совсем недавно общался. Её волосы разметались по камню, платье разорвано. Они наваливаются на неё, как стая."
    troll "Ха-ха! Человечка так вкусно кричит! Тролли будут веселиться!"
    scene bg lira troll_gang2 with fade
    troll "Ты думала, обманешь Тролля? Заплатишь!"
    "Её крик – как нож, который входит в ухо. Она зовёт на помощь, но никто не приходит. Я стою как вкопанный, и мои руки сжимаются в кулаки, но я не могу пошевелиться."
    scene bg lira troll_gang3 with fade
    lira "Дима... где ты... почему ты не идёшь..."
    play sound fuck loop volume 0.7
    "Они разрывают её одежду, входят в неё по кругу. Она кричит. Я слышу, как её тело ударяется о камень. Каждый звук – как удар молотом по моей совести."
    scene bg lira troll_gang4 with fade
    play sound cum
    "Слышу её крики, плач. Голос становится тише. Она перестаёт кричать. Наступает тишина – тяжёлая, как могильный камень."
    scene bg lira troll_gang5 with fade
    play sound cum
    troll "Ха! Человечка сломалась. Теперь она – просто мясо."
    scene black with fade
    troll "Ещё один человечек! Хотел спасти подружку?"
    "Я не успеваю среагировать. Чьи-то руки хватают меня сзади. Швыряют в камеру. Я падаю на холодный камень и слышу, как лязгает замок."
    "Закрываю глаза. Пришёл слишком поздно. Я не спас её. Я даже не попытался по-настоящему. Я просто стоял и смотрел, как её убивают."
    "Тьма заполняет камеру. Я чувствую, как она проникает в лёгкие, в кровь, в мысли."
    scene black with fade
    "Плохая концовка: вечное заточение. Я буду сидеть здесь до конца своих дней, и каждый раз, закрывая глаза, я буду слышать её крик."
    "Я думаю о том, что мог бы сделать иначе – ударить, закричать, попытаться отвлечь их. Но я ничего не сделал. Я просто смотрел."
    "Иногда самое страшное поражение – это не смерть. Это осознание того, что ты мог бы спасти кого-то, но выбрал свою шкуру."
    jump bad_end


# ---------- ПОСЛЕ ПОБЕГА (ПЕРЕХОДНЫЕ МЕТКИ) ----------
# Метка after_escape_success – переход после одиночного побега.
# Игрок оказывается на поляне, отдыхает, затем выбирает между таверной и участком шерифа.
label after_escape_success:
    stop music
    play music music_prolog loop
    scene bg village_sleep with fade
    "Выхожу на поляну. Солнце клонится к закату. Свет — живой, настоящий, не похожий на те жёлтые пятна, что горели в подземелье."
    "Я сажусь у пня, прислоняюсь к дереву. Кора шершавая, тёплая. Впервые за долгое время я чувствую, что могу просто дышать. Глубоко, без страха, что вдох станет последним."
    "Воздух пахнет травой, мокрой землёй и чем-то сладким — может быть, цветами. Я вдыхаю этот запах и понимаю, что забыл, как пахнет жизнь. В темнице был только камень, плесень и смерть."
    "Я смотрю на свои руки. Они грязные, в царапинах, но целые. Я жив. Я выбрался."
    show gg tired at center_pos
    "Закрываю глаза. В голове всё ещё звучат шаги, рык тролля, голос Лиры. Но постепенно они затихают, растворяются в шуме ветра."
    "Я позволяю себе просто быть — без мыслей, без страха, без плана. Короткий сон. Тьма снова накрывает меня, но на этот раз она мягкая, без запаха серы."
    scene black with fade
    pause 1.0
    scene bg village_sleep with fade
    show gg tired at center_pos
    "Просыпаюсь от птиц. Солнце высоко, и я чувствую его тепло на лице. Настоящее, живое тепло."
    "Мои мышцы болят, но боль — это напоминание, что я всё ещё здесь, что я не стал частью той темницы. Я сажусь, оглядываюсь. Поляна, лес, дорога. Никаких решёток, никаких факелов. Только зелень и небо."
    "Как будто никогда не было никакого подземелья. Но шрамы на моих руках говорят об обратном. Я чувствую себя отдохнувшим. Не счастливым — нет. Счастливые люди не оказываются в подземельях. Но я жив. И это — начало."
    scene bg village_road with fade
    show gg tired at center_pos
    "Передо мной развилка. Две дороги. Налево — таверна, где пахнет элем и жареным мясом. Направо — участок шерифа, где меня ждут вопросы, на которые у меня нет ответов."
    "Я стою и смотрю на обе дороги. Внутри — тишина. Я не знаю, куда идти. Но знаю, что стоять на месте нельзя."
    menu:
        "Таверна.":
            "Я сворачиваю налево. Там — тепло, еда, может быть, забытьё. Туда, где можно притвориться, что я обычный человек."
            jump tavern_alone
        "Участок шерифа.":
            "Я сворачиваю направо. Там — правда. Или её подобие. Туда, где я должен ответить за то, что видел и что сделал."
            jump police_route_alone

# Метка after_escape_together – переход после совместного побега с Лирой.
# Аналогично одиночному, но с Лирой, которая может влиять на выбор.
label after_escape_together:
    stop music
    play music music_prolog loop
    scene bg village_sleep with fade
    "Мы выходим на поляну. Свет бьёт в глаза, и я щурюсь, чувствуя, как солнечные лучи касаются лица. Лира идёт рядом, её плечо касается моего."
    "Усталость наваливается, как бетонная плита. Мои ноги подкашиваются, и я сажусь на траву, прислоняясь к старому пню. Лира опускается рядом. Я чувствую, как она кладёт голову мне на плечо. Её дыхание становится ровным, спокойным."
    "Впервые за долгое время я чувствую, что я не один."
    show gg tired at left_pos
    show lira stand at right_pos
    "Ветер шевелит траву. Где-то поют птицы. Я слышу шум леса – настоящий, живой шум, а не эхо каменных стен."
    lira "Мы сделали это. Мы живы."
    gg "Да. Мы живы."
    "Я не говорю больше ни слова. Внутри – тишина. Не та пустая тишина, что была в темнице, а спокойная, тёплая. Я закрываю глаза и чувствую, как сон накрывает меня."
    scene black with fade
    pause 1.0
    scene bg village_sleep with fade
    show gg tired at left_pos
    show lira smile at right_pos
    "Просыпаемся от птиц. Солнце уже высоко, и я чувствую его тепло на лице. Лира всё ещё рядом, её голова лежит у меня на плече."
    "Я смотрю на неё. Она улыбается во сне. Я вижу, как её губы слегка приоткрыты, как ветер играет с её волосами. Она выглядит спокойной – впервые за всё время, что я её знаю."
    "Я не хочу будить её. Но она открывает глаза и смотрит на меня."
    lira "Ты смотрел на меня."
    gg "Просто проверял, что ты жива."
    lira "Я жива. Мы живы."
    "Мы встаём. Я чувствую, как мышцы болят, но боль – это приятное напоминание о том, что мы выжили."
    scene bg village_road with fade
    show gg tired at left_pos
    show lira smile at right_pos
    "Перед нами развилка. Две дороги. Одна ведёт к таверне, другая – к участку шерифа. Я смотрю на Лиру. Она смотрит на меня."
    gg "Куда пойдем?"
    lira "Куда ты скажешь. Я с тобой."
    "Я чувствую её доверие. Это тяжело – нести ответственность за двоих. Но я не хочу её подвести."
    menu:
        "Таверна.":
            "Я выбираю путь тепла и еды. Мы заслужили отдых."
            jump tavern_together
        "Участок шерифа.":
            "Я выбираю путь правды. Пора узнать, что на самом деле произошло."
            jump police_together