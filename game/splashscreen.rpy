# ============================================================
# ЗАСТАВКА (SPLASHSCREEN)
# ============================================================
#
# Этот файл определяет метку `splashscreen`, которая автоматически
# вызывается при запуске игры (если она настроена в параметрах
# проекта). Она используется для отображения краткого вступления,
# логотипов, дисклеймеров или предупреждений перед появлением
# главного меню.
#
# В Ren'Py метка splashscreen — это специальная метка, которая
# выполняется до главного меню. Если она присутствует в коде,
# Ren'Py запускает её автоматически при старте игры.
#
# В данном случае на экране отображается только дисклеймер
# (предупреждение о содержании, возрастные ограничения и т.п.)
# и игра ждёт нажатия кнопки мыши или клавиши, чтобы продолжить.
# ============================================================

label splashscreen:

    # Очищаем экран — устанавливаем чёрный фон.
    # Это гарантирует, что предыдущие кадры (если были) не видны.
    scene black

    # Показываем спрайт/изображение `splash_disclaimer` с эффектом
    # растворения (dissolve). Это изображение должно быть определено
    # в файле images.rpy или в папке images.
    # Обычно это текст с предупреждением, например: "18+", "Fiction",
    # "Данный продукт содержит сцены насилия" и т.п.
    show splash_disclaimer with dissolve

    # Останавливаем выполнение сценария до тех пор, пока игрок
    # не кликнет или не нажмёт любую клавишу.
    # `renpy.pause()` без аргументов приостанавливает игру бесконечно,
    # пока не будет получено действие игрока (клик, нажатие).
    # Это позволяет игроку прочитать дисклеймер и подтвердить готовность.
    $ renpy.pause()

    # После клика скрываем изображение дисклеймера с эффектом растворения.
    # Возвращаемся обратно — Ren'Py продолжит выполнение, что приведёт
    # к переходу к главному меню (так как после метки splashscreen
    # автоматически запускается главное меню).
    hide splash_disclaimer with dissolve

    # Метка завершается, управление возвращается в Ren'Py,
    # который затем показывает главное меню.
    return